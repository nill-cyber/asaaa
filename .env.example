# Telegram
BOT_TOKEN=123456:ABC-your-bot-token

# Firebase Admin (Service Account থেকে)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# Vercel-এ বসানোর সময় \n যেমন আছে তেমনই রাখুন
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# নিজে বানানো লম্বা random secret (কমপক্ষে ৩২ অক্ষর): openssl rand -hex 32
SERVER_SECRET=change-me-long-random-string

# Admin প্যানেল: ব্রাউজারে /admin খুলে এই পাসওয়ার্ড দিয়ে ঢোকা যায় (কঠিন পাসওয়ার্ড দিন)
ADMIN_PASSWORD=change-this-strong-password

# (ঐচ্ছিক) Telegram-এর ভেতর থেকেও Admin হতে চাইলে আপনার Telegram user ID (কমা দিয়ে একাধিক)
ADMIN_TELEGRAM_IDS=123456789

# Mini App-এর পাবলিক URL (শুধু রেফারেন্স)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---- ঐচ্ছিক (না দিলে ডিফল্ট) ----
# MIN_WITHDRAW=10000
# WITHDRAW_METHODS=bKash,Nagad,Rocket,USDT (TRC20)
# COINS_PER_UNIT=1000
# UNIT_LABEL=BDT
# RUN_TTL_MIN=60
# CODE_TTL_MIN=10

# Background checks (price alerts, limit orders, bot messages, weekly leaderboard prizes)
# নিজে বানানো random secret; cron-job.org থেকে https://YOUR-SITE/api/cron?key=<এই secret> প্রতি ১-৫ মিনিটে খুলুন
CRON_SECRET=change-me-another-long-random-string

# (ঐচ্ছিক) Rewarded ads-এ server-verify: Adsgram Reward URL = https://YOUR-SITE/api/ad-callback?userid=[userId]&secret=<এই secret>
ADS_SECRET=

# --- Binance auto-approve (optional) ---
# Easiest: leave these empty and paste the key in Admin → Market & Trading → Binance auto-approve (stored encrypted).
# Or set them here. Key must have ONLY "Enable Reading" turned on.
BINANCE_API_KEY=
BINANCE_API_SECRET=
